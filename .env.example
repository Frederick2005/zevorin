# Variable NAMES only. Never put real values in this file.
# Local dev: copy to .env (gitignored) and fill in.
# Cloudflare: see DEPLOYMENT.md for where each one is configured.

# --- Public (safe for browser). Needed at BUILD time (Vite inlines VITE_*) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server runtime (Worker variables) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Server-only SECRETS (Worker secrets, never VITE_-prefixed) ---
# REQUIRED for checkout: the server creates/settles orders with the admin client.
SUPABASE_SERVICE_ROLE_KEY=
# Flutterwave v3 secret key (test key while testing). Required for checkout.
FLUTTERWAVE_SECRET_KEY=
# Any long random string YOU choose. Enter the same value as the "Secret hash"
# in Flutterwave Dashboard > Settings > Webhooks. Required for the webhook.
FLUTTERWAVE_WEBHOOK_HASH=

# --- Optional ---
# Public site URL used for payment return links (e.g. https://zevorin.example.com).
# Defaults to the request's own origin.
SITE_URL=
