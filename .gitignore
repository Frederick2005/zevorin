# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.example.*
!.env.sample
!.env.sample.*
!.env.template
!.env.template.*

# Cloudflare and Wrangler secrets
.dev.vars
.dev.vars.*
.wrangler/
.wrangler-state/
.local.cloudflare/

# Build outputs
dist/
dist-ssr/
.output/
.vinxi/
.tanstack/
.nitro/
build/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager caches
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml

# Local databases and temporary files
*.sqlite
*.sqlite3
*.db-journal
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo
*~

# Test and coverage artifacts
playwright-report/
test-results/
.nyc_output/

# TypeScript build artifacts
*.tsbuildinfo

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local tool and debugging files
*.local
.envrc
.turbo/

# Keep the repository's safe environment examples
!env.example
!env.example.*
!